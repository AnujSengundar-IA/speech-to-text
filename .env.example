# Whisper model
WHISPER_MODEL_SIZE=small.en
WHISPER_MODEL_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_VAD_FILTER=true

# Parakeet model
PARAKEET_MODEL_ID=nvidia/parakeet-tdt-0.6b-v3
PARAKEET_DEVICE=cpu
PARAKEET_TORCH_DTYPE=float32

# Audio and segmentation
SAMPLE_RATE=16000
MIN_AUDIO_SEC=0.5
SILENCE_SEC=1.0
MAX_SEGMENT_SEC=10.0
MAX_BUFFER_SEC=15.0
PARTIAL_INTERVAL_SEC=1.0
OVERLAP_SEC=1.0

# Adaptive silence detection
SILENCE_MULTIPLIER=2.5
SILENCE_RMS_FLOOR=0.003
NOISE_ALPHA=0.1
MIN_NOISE_FLOOR=0.0005

# Connection behavior
CLIENT_TIMEOUT_SEC=20
MAX_CONCURRENT_TRANSCRIBES=2
TRANSCRIBE_ACQUIRE_TIMEOUT_SEC=5

# Security (optional)
# Comma-separated allowlist. Leave empty to allow any origin.
WS_ALLOWED_ORIGINS=
# Shared token for websocket auth. Leave empty to disable token auth.
WS_AUTH_TOKEN=
