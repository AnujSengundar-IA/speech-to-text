# Whisper model
WHISPER_MODEL_SIZE=small.en
WHISPER_MODEL_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_VAD_FILTER=true

# Parakeet model
PARAKEET_MODEL_ID=nvidia/parakeet-ctc-0.6b
PARAKEET_DEVICE=cpu
PARAKEET_TORCH_DTYPE=float32

# IndicConformer model (AI4Bharat NeMo checkpoint)
# Example:
# INDICCONFORMER_CHECKPOINT_PATH=/absolute/path/to/conformer-multilingual-all.nemo
# Or HF snapshot directory/repo id:
# INDICCONFORMER_CHECKPOINT_PATH=/home/<user>/.cache/huggingface/hub/models--ai4bharat--indic-conformer-600m-multilingual/snapshots/<commit>
# INDICCONFORMER_CHECKPOINT_PATH=ai4bharat/indic-conformer-600m-multilingual
INDICCONFORMER_DEVICE=cpu
INDICCONFORMER_DECODER=ctc
INDICCONFORMER_DEFAULT_LANGUAGE_ID=hi
INDICCONFORMER_BATCH_SIZE=1

# Audio and segmentation
SAMPLE_RATE=16000
MIN_AUDIO_SEC=0.5
SILENCE_SEC=1.0
MAX_SEGMENT_SEC=10.0
MAX_BUFFER_SEC=15.0
PARTIAL_INTERVAL_SEC=1.0
OVERLAP_SEC=1.0

# Adaptive silence detection
SILENCE_MULTIPLIER=2.5
SILENCE_RMS_FLOOR=0.003
NOISE_ALPHA=0.1
MIN_NOISE_FLOOR=0.0005

# Connection behavior
CLIENT_TIMEOUT_SEC=20
MAX_CONCURRENT_TRANSCRIBES=2
TRANSCRIBE_ACQUIRE_TIMEOUT_SEC=5

# Security (optional)
# Comma-separated allowlist. Leave empty to allow any origin.
WS_ALLOWED_ORIGINS=
# Shared token for websocket auth. Leave empty to disable token auth.
WS_AUTH_TOKEN=
